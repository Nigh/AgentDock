# Copy to .env before `docker compose up -d`

# Host-side publish spec for the container's :8080. Plain port ("8080",
# "9000") or ip:port ("127.0.0.1:8080" — recommended behind a reverse
# proxy so the container is never internet-reachable directly).
AGENTDOCK_PUBLISH=127.0.0.1:8080

# "true" when served behind an HTTPS reverse proxy (recommended).
# "false" only for plain-http testing.
AGENTDOCK_COOKIE_SECURE=true
