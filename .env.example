# Copy to .env before `docker compose up -d`

# Shared secret for the PC node connection. Generate: openssl rand -hex 24
AGENTDOCK_NODE_TOKEN=

# First-run bootstrap of the single user (ignored once a user exists).
AGENTDOCK_ADMIN_USER=
AGENTDOCK_ADMIN_PASSWORD=

# "true" when served behind an HTTPS reverse proxy (recommended).
# "false" only for plain-http testing.
AGENTDOCK_COOKIE_SECURE=true
